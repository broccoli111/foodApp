{
  "name": "kitchen-compass",
  "version": "0.1.0",
  "description": "Kitchen Compass iOS-first household meal planning MVP.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push",
    "supabase:lint": "supabase db lint",
    "supabase:types": "supabase gen types typescript --local --schema public > lib/supabase/database.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "expo": "^56.0.4",
    "expo-camera": "^56.0.7",
    "expo-constants": "^56.0.15",
    "expo-file-system": "^56.0.7",
    "expo-haptics": "^56.0.3",
    "expo-image-picker": "^56.0.13",
    "expo-router": "^56.2.6",
    "expo-status-bar": "^56.0.4",
    "nativewind": "^4.2.4",
    "react": "^19.2.6",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "supabase": "^2.101.0",
    "typescript": "^6.0.3"
  },
  "private": true
}
